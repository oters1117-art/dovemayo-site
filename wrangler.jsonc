{
  "name": "dovemayo-site",
  "account_id": "a3d1feae61a64987b6ff5025c69f6cb0",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  // The worker only answers /api/board/* (suggestion board); everything else is served from dist/.
  "main": "worker/index.mjs",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/board/*"] },
  "durable_objects": { "bindings": [ { "name": "BOARD", "class_name": "Board" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Board"] } ],
  "routes": [ { "pattern": "dovemayo.com", "custom_domain": true } ]
}
